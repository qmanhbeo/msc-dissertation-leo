# OpenAlex API credentials — required for --cold-replay (fetch_openalex.py, fetch_aurora.py)
# Get a free API key at https://openalex.org/keys
OPENALEX_MAILTO=your.email@example.com
OPENALEX_API_KEY=your_api_key_here

# Rate-limit fallback credentials (optional — only needed for high-volume refetching)
# OPENALEX_RATE_LIMIT_MAILTO=fallback1@example.com
# OPENALEX_RATE_LIMIT_API_KEY=fallback_key_1
# OPENALEX_RATE_LIMIT_MAILTO_2=fallback2@example.com
# OPENALEX_RATE_LIMIT_API_KEY_2=fallback_key_2
# OPENALEX_RATE_LIMIT_MAILTO_3=fallback3@example.com
# OPENALEX_RATE_LIMIT_API_KEY_3=fallback_key_3
